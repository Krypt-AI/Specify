# --- Backend ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://mailup:mailup@db:5432/mailup
REDIS_URL=redis://redis:6379/0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Optional: a restricted role for user requests, so PostgreSQL row-level security keeps every
# user's data apart even if a query forgets its user filter. The backend creates the role with
# this password on start (see docs/SECURITY.md). Leave empty to use DATABASE_URL for everything.
REQUEST_DATABASE_URL=
# REQUEST_DATABASE_URL=postgresql+psycopg://specify_app:<long random password>@db:5432/mailup

# --- Google OAuth (Google Cloud Console > Credentials > OAuth client ID, Web application) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI must equal: ${BACKEND_URL}/api/auth/google/callback

# --- Gmail push notifications (optional; needs a public HTTPS backend, see docs/GOOGLE_SETUP.md) ---
# Without these, Specify polls Gmail every few minutes.
GMAIL_PUBSUB_TOPIC=
# GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/specify-gmail
GMAIL_PUSH_AUDIENCE=
# GMAIL_PUSH_AUDIENCE=https://api.example.com/api/webhooks/gmail
GMAIL_PUSH_SERVICE_ACCOUNT=
# GMAIL_PUSH_SERVICE_ACCOUNT=specify-push@<project-id>.iam.gserviceaccount.com

# --- AI provider ---
# ollama: a local model; email content never leaves your machine (see docs/AI_SETUP.md).
# anthropic: the Claude API (needs ANTHROPIC_API_KEY).
# none: your rules and manual review only.
AI_PROVIDER=ollama
# From Docker containers use host.docker.internal; when running the backend directly use localhost.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Frontend ---
VITE_API_URL=http://localhost:8000
